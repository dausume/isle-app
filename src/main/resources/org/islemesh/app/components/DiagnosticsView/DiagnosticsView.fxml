<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      styleClass="home-page"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.islemesh.app.components.DiagnosticsView.DiagnosticsViewController">

    <!-- Header -->
    <HBox alignment="CENTER" styleClass="mode-banner">
        <padding>
            <Insets top="12" right="20" bottom="12" left="20"/>
        </padding>
        <Label text="Diagnostics"
               styleClass="banner-text"/>
    </HBox>

    <!-- Scrollable Content -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;">
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="30" bottom="10" left="30"/>
            </padding>

            <!-- Isle Routing Section -->
            <Label text="Isle Routing (.isle)" styleClass="section-header"/>

            <VBox fx:id="isleTestsList" spacing="6"
                  styleClass="status-card">
                <padding>
                    <Insets top="8" right="12" bottom="8" left="12"/>
                </padding>
            </VBox>

            <Separator/>

            <!-- mDNS / Agent Section -->
            <Label text="mDNS / Agent (.local)" styleClass="section-header"/>

            <VBox fx:id="mdnsTestsList" spacing="6"
                  styleClass="status-card">
                <padding>
                    <Insets top="8" right="12" bottom="8" left="12"/>
                </padding>
            </VBox>

            <Separator/>

            <!-- Remote Devices Section (shown conditionally) -->
            <Label fx:id="remoteHeader"
                   text="Remote Devices" styleClass="section-header"
                   visible="false" managed="false"/>

            <VBox fx:id="remoteTestsList" spacing="6"
                  styleClass="status-card"
                  visible="false" managed="false">
                <padding>
                    <Insets top="8" right="12" bottom="8" left="12"/>
                </padding>
            </VBox>

            <Separator/>

            <!-- Summary -->
            <HBox alignment="CENTER" spacing="10">
                <Label fx:id="summaryLabel"
                       text=""
                       styleClass="status-text"
                       wrapText="true"/>
            </HBox>

            <!-- Actions -->
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="runButton"
                        text="Run Tests"
                        styleClass="btn, btn-primary"
                        prefWidth="140" prefHeight="38"
                        onAction="#onRunTests"/>

                <Button text="Back"
                        styleClass="btn, btn-secondary"
                        prefWidth="100" prefHeight="38"
                        onAction="#onBack"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
