<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      styleClass="home-page"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.islemesh.app.components.AppsView.AppsViewController">

    <!-- Mode Banner -->
    <HBox alignment="CENTER" styleClass="mode-banner">
        <padding>
            <Insets top="12" right="20" bottom="12" left="20"/>
        </padding>
        <Label fx:id="modeBanner"
               text="..."
               styleClass="banner-text"/>
    </HBox>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <padding>
            <Insets top="16" right="24" bottom="8" left="24"/>
        </padding>
        <Label text="Registered Apps" styleClass="title" HBox.hgrow="ALWAYS"/>
        <Button text="Refresh"
                styleClass="btn, btn-secondary"
                prefHeight="30"
                onAction="#onRefresh"/>
    </HBox>

    <!-- Apps List -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;">
        <VBox fx:id="appsList" spacing="10">
            <padding>
                <Insets top="8" right="24" bottom="16" left="24"/>
            </padding>
        </VBox>
    </ScrollPane>

    <!-- Empty state -->
    <Label fx:id="emptyLabel"
           text="No apps registered yet."
           styleClass="subtitle"
           visible="false" managed="false"
           VBox.vgrow="ALWAYS"
           style="-fx-alignment: center;"/>

    <!-- Footer -->
    <HBox alignment="CENTER">
        <padding>
            <Insets top="8" right="24" bottom="16" left="24"/>
        </padding>
        <Button text="Back to Home"
                styleClass="btn, btn-secondary"
                prefWidth="160" prefHeight="36"
                onAction="#onBack"/>
    </HBox>
</VBox>
