<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      styleClass="home-page"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.islemesh.app.components.PortsView.PortsViewController">

    <HBox alignment="CENTER" styleClass="mode-banner">
        <padding>
            <Insets top="12" right="20" bottom="12" left="20"/>
        </padding>
        <Label text="Network Ports" styleClass="banner-text"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;">
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="30" bottom="10" left="30"/>
            </padding>

            <Label text="Your wired ports. Switch a cable onto the isle to connect a device on it."
                   styleClass="status-text" wrapText="true"/>
            <Label fx:id="bridgeNote" text="" styleClass="status-text" wrapText="true"/>

            <VBox fx:id="portList" spacing="8">
            </VBox>

            <Label fx:id="statusLabel" text="" styleClass="status-text" wrapText="true"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Refresh"
                        styleClass="btn, btn-secondary"
                        prefWidth="100" prefHeight="36"
                        onAction="#onRefresh"/>
                <Button text="Back"
                        styleClass="btn, btn-secondary"
                        prefWidth="100" prefHeight="36"
                        onAction="#onBack"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
