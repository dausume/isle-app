<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      styleClass="home-page"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.islemesh.app.components.DevicesView.DevicesViewController">

    <!-- Header -->
    <HBox alignment="CENTER" styleClass="mode-banner">
        <padding>
            <Insets top="12" right="20" bottom="12" left="20"/>
        </padding>
        <Label text="Device Discovery" styleClass="banner-text"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;">
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="30" bottom="10" left="30"/>
            </padding>

            <!-- Discovery mode -->
            <Label text="Discovery Mode" styleClass="section-header"/>
            <VBox styleClass="status-card" spacing="10">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <Label fx:id="discoveryStatusLabel" text="Checking..."
                       styleClass="status-text" wrapText="true"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="toggleDiscoveryButton" text="Start Discovery"
                            styleClass="btn, btn-primary"
                            prefWidth="160" prefHeight="36"
                            onAction="#onToggleDiscovery"/>
                    <Button fx:id="scanButton" text="Scan Now"
                            styleClass="btn, btn-success"
                            prefWidth="120" prefHeight="36"
                            onAction="#onScan"/>
                </HBox>
            </VBox>

            <Separator/>

            <!-- Devices -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Devices" styleClass="section-header"/>
                <Label fx:id="summaryLabel" text="" styleClass="status-text"/>
            </HBox>

            <VBox fx:id="deviceList" spacing="8">
            </VBox>

            <!-- Actions -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Add Manually"
                        styleClass="btn, btn-secondary"
                        prefWidth="140" prefHeight="36"
                        onAction="#onAddManual"/>
                <Button text="Refresh"
                        styleClass="btn, btn-secondary"
                        prefWidth="100" prefHeight="36"
                        onAction="#onRefresh"/>
                <Button text="Back"
                        styleClass="btn, btn-secondary"
                        prefWidth="100" prefHeight="36"
                        onAction="#onBack"/>
            </HBox>

            <!-- Console (scan output) -->
            <VBox fx:id="consoleSection" visible="false" managed="false" spacing="4">
                <Label text="Output" styleClass="section-header"/>
                <ScrollPane fx:id="consoleScroll"
                            prefHeight="120" fitToWidth="true"
                            style="-fx-background-color: #2c3e50;">
                    <Label fx:id="consoleOutput" text="" styleClass="console-text" wrapText="true"/>
                </ScrollPane>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
